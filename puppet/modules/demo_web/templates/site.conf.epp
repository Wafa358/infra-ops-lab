<%- |
  Array[String] $server_names,
  Array[String] $trusted_proxies,
  String $served_by,
  Integer $app_port,
  String $access_log,
| -%>
# Managed by Puppet (class demo_web). Manual edits are reverted at the next run.
upstream demo_app {
    server 127.0.0.1:<%= $app_port %>;
    keepalive 16;
}

server {
    listen 80 default_server;
    server_name <%= $server_names.join(' ') %>;

    # "combined" format: scripts/log-triage.sh reads this file directly.
    access_log <%= $access_log %> combined;

    # Log the real client address instead of the load balancer's. The X-Forwarded-For
    # header is trusted from the load balancer only, so a client cannot fake its address.
<% $trusted_proxies.each |$proxy| { -%>
    set_real_ip_from <%= $proxy %>;
<% } -%>
    real_ip_header X-Forwarded-For;

    location = /health {
        proxy_pass http://demo_app;
        access_log off;
    }

    location / {
        proxy_pass http://demo_app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        add_header X-Served-By <%= $served_by %> always;
    }
}
