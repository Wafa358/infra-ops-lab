# Managed by Ansible (role nginx)
upstream demo_app {
    server 127.0.0.1:8000;
    keepalive 16;
}

server {
    listen 80 default_server;
    server_name {{ web_service_name }} {{ inventory_hostname }}.{{ lab_domain }};

    # "combined" format: scripts/log-triage.sh reads this file directly.
    access_log /var/log/nginx/demo-app.access.log combined;

    location = /health {
        proxy_pass http://demo_app;
        access_log off;
    }

    location / {
        proxy_pass http://demo_app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        add_header X-Served-By {{ inventory_hostname }} always;
    }
}
