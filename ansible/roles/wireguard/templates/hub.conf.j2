# Managed by Ansible (role wireguard). {{ inventory_hostname }} is the VPN hub.
[Interface]
Address = {{ vpn_addresses[inventory_hostname] }}/24
ListenPort = {{ vpn_port }}
PostUp = wg set %i private-key {{ wireguard_dir }}/{{ wireguard_interface }}.key

# The control node, the only peer allowed to reach the VMs through the hub
[Peer]
PublicKey = {{ hostvars['localhost'].wireguard_client_public_key }}
AllowedIPs = {{ vpn_client_address }}/32
{% for host in groups['lab'] | sort if host != inventory_hostname %}

# {{ host }}
[Peer]
PublicKey = {{ hostvars[host].wireguard_public_key }}
AllowedIPs = {{ vpn_addresses[host] }}/32
{% endfor %}
