# Managed by Ansible (role haproxy)
global
    log /dev/log local0
    maxconn 2048
    user haproxy
    group haproxy
    daemon
    ssl-default-bind-options ssl-min-ver TLSv1.2 no-tls-tickets

defaults
    mode http
    log global
    option httplog
    option forwardfor
    # If a web server refuses a connection (found in incident drill 1: the requests sent in
    # the 4 seconds before its health checks fail), retry once on another server.
    retries 1
    option redispatch 1
    timeout connect 5s
    timeout client 30s
    timeout server 30s

# Plain HTTP only redirects to HTTPS.
frontend http_in
    bind *:80
    http-request redirect scheme https code 301

frontend https_in
    bind *:443 ssl crt /etc/haproxy/certs/www.pem alpn h2,http/1.1
    http-request set-header X-Forwarded-Proto https
    http-response set-header Strict-Transport-Security "max-age=31536000"
    default_backend web

# Round robin across the web tier; a server leaves the pool after 2 failed health checks.
backend web
    balance roundrobin
    option httpchk GET /health
    http-check expect status 200
{% for host in groups['web'] %}
    server {{ host }} {{ hostvars[host].ansible_host }}:80 check inter 2s fall 2 rise 2
{% endfor %}

listen stats
    bind *:8404
    stats enable
    stats uri /stats
    stats refresh 5s
