; Managed by Ansible (role dns_server) - generated from the inventory.
$TTL 300
@        IN SOA {{ inventory_hostname }}.{{ lab_domain }}. hostmaster.{{ lab_domain }}. (
             {{ dns_server_serial }} ; serial
             3600       ; refresh
             600        ; retry
             86400      ; expire
             300 )      ; negative-answer TTL
         IN NS  {{ inventory_hostname }}.{{ lab_domain }}.
{% for host in groups['lab'] | sort %}
{{ '%-8s' | format(host) }} IN A   {{ hostvars[host].ansible_host }}
{% endfor %}
www      IN CNAME {{ groups['lb'][0] }}
